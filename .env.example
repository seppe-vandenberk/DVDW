API_PORT=8000
DQN_DEVICE=cpu
VIEWER_PORT=8080
BIND_HOST=127.0.0.1
MODEL_ONE=shared
MODEL_TWO=rules
SIM_SWAP_SIDES=true
SIM_INTERVAL=0.25
SIM_RESULT_DELAY=0.0001
AI_BACKEND=az
AI_BACKGROUND=true
AI_SEARCH_SIMULATIONS=64
AI_TRAIN_SIMULATIONS=32
AI_BATCH_GAMES=16
AI_EVALUATION_SECONDS=300
AI_GATE_GAMES=40

# Leave blank for the shared STEM-day mock camera. For the real camera (camera/connect4_reader.py,
# started on the host with --rows 5) use: http://host.docker.internal:8001/state
# (direct Python runs: http://127.0.0.1:8001/state)
CAMERA_API_URL=
CAMERA_POLL_DELAY_MS=500

# Direct Python runs; Compose persists scores under runtime/event instead.
EVENT_SCORE_FILE=runtime/robot_scores.txt

AI_TRAIN_MOVE_DELAY_SECONDS=0.5
